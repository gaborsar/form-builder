{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "target": "esnext",
    "paths": {
      "dfrm-components": ["./src/packages/dfrm-components"],
      "dfrm-schema": ["./src/packages/dfrm-schema"],
      "dfrm-renderer": ["./src/packages/dfrm-renderer"]
    }
  },
  "exclude": ["node_modules", "build"]
}
